FROM node:23-alpine

WORKDIR /app

# Install dependencies first (cached unless package files change)
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install

# App source is bind-mounted in docker-compose for hot reload,
# but copy it so the image also works standalone.
COPY . .

EXPOSE 8000

# --hostname 0.0.0.0 makes the dev server reachable from outside the container.
CMD ["sh", "-c", "npm run dev -- --port ${WEB_PORT:-8000} --hostname 0.0.0.0"]
