# Environment: development | production
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=roseltorg
# Host port the dockerized Postgres is exposed on (container always uses 5432).
# A backend run locally (without docker) connects to localhost:5433 by default.
DB_EXTERNAL_PORT=5432

# ─── Backend (FastAPI) ────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── AI / OpenRouter ──────────────────────────────────────────
# Get a key at https://openrouter.ai/keys (required for the AI chat).
OPENROUTER_API_KEY=
# Free model (no credits needed). Browse: https://openrouter.ai/models?max_price=0
AI_MODEL=deepseek/deepseek-chat-v3-0324:free
# Optional outbound proxy for OpenRouter, e.g. http://user:pass@host:8080
# or socks5://host:1080. Leave empty for a direct connection.
PROXY_URL=

# ─── Frontend (Next.js) ───────────────────────────────────────
WEB_PORT=8000
# API URL as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEB_URL=http://localhost:8000

# ─── Monitoring (optional: `docker compose --profile monitoring up`) ──
GRAFANA_LOGIN=admin
GRAFANA_PASSWORD=admin
